{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "migration_family": {
      "enum": [
        "unstructured_search",
        "combinatorial_optimization",
        null
      ]
    },
    "context_level": {
      "enum": [
        "kernel",
        "function_with_distractors",
        "small_program"
      ]
    },
    "case_type": {
      "enum": [
        "positive",
        "hard_negative",
        "negative"
      ]
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard",
        "unknown"
      ]
    },
    "classical_program": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
      }
    },
    "candidate_regions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
          },
          "function": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "file",
          "start_line",
          "end_line"
        ]
      }
    },
    "structural_eligibility": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "practical_suitability": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "benchmark_supported": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "expected_decision": {
      "enum": [
        "QUANTUMIZE",
        "REMAIN_CLASSICAL",
        null
      ]
    },
    "computational_intent": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "description"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "admissible_migration_contracts": {
      "type": "array",
      "items": {
        "$ref": "https://qrefactorbench.example/schemas/0.1.0/migration_plan.schema.json#/$defs/contract"
      }
    },
    "reference_plan": {
      "anyOf": [
        {
          "$ref": "https://qrefactorbench.example/schemas/0.1.0/migration_plan.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "reference_hybrid_implementation": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "classical_tests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
      }
    },
    "semantic_oracle": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "deterministic_equality",
                "property",
                "optimization_feasibility",
                "optimization_objective",
                "probabilistic"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "config": {
              "type": "object"
            },
            "hook_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "description",
            "config"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "resource_expectations": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "num_qubits": {
                  "type": "integer",
                  "minimum": 0
                },
                "depth": {
                  "type": "integer",
                  "minimum": 0
                },
                "operation_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "gate_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "two_qubit_gate_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "measurement_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "shots": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "execution_config": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shots": {
                  "type": "integer",
                  "minimum": 1
                },
                "seed": {
                  "type": "integer",
                  "minimum": 0
                },
                "backend": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": []
            }
          },
          "required": [
            "assumptions",
            "limits"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "negative_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "annotation_rationale": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "annotators": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "annotation_status": {
      "enum": [
        "DRAFT",
        "REVIEWED",
        "ADJUDICATED",
        "FROZEN"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "independent_annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "annotator_id": {
                "type": "string",
                "minLength": 1
              },
              "artifact": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
              }
            },
            "required": [
              "annotator_id",
              "artifact"
            ]
          },
          "minItems": 2
        },
        "disagreements": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
        },
        "adjudicator_id": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
        }
      },
      "required": [
        "independent_annotations",
        "disagreements"
      ]
    },
    "benchmark_release": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "title",
    "description",
    "source",
    "source_url",
    "license",
    "domain",
    "version",
    "migration_family",
    "context_level",
    "case_type",
    "difficulty",
    "candidate_regions",
    "structural_eligibility",
    "practical_suitability",
    "benchmark_supported",
    "expected_decision",
    "annotation_status"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qrefactorbench.example/schemas/0.1.0/case.schema.json",
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
        },
        "function": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line"
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "classical_program"
      ],
      "not": {
        "required": [
          "files"
        ]
      }
    },
    {
      "required": [
        "files"
      ],
      "not": {
        "required": [
          "classical_program"
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "case_type": {
            "const": "positive"
          }
        }
      },
      "then": {
        "properties": {
          "candidate_regions": {
            "minItems": 1
          },
          "structural_eligibility": {
            "enum": [
              true,
              null
            ]
          },
          "practical_suitability": {
            "enum": [
              true,
              null
            ]
          },
          "benchmark_supported": {
            "enum": [
              true,
              null
            ]
          },
          "expected_decision": {
            "enum": [
              "QUANTUMIZE",
              null
            ]
          },
          "negative_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_type": {
            "enum": [
              "negative",
              "hard_negative"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "expected_decision": {
            "enum": [
              "REMAIN_CLASSICAL",
              null
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "annotation_status": {
            "enum": [
              "REVIEWED",
              "ADJUDICATED",
              "FROZEN"
            ]
          }
        }
      },
      "then": {
        "required": [
          "computational_intent",
          "admissible_migration_contracts",
          "classical_tests",
          "semantic_oracle",
          "resource_expectations",
          "annotation_rationale",
          "annotators",
          "review"
        ],
        "properties": {
          "structural_eligibility": {
            "type": "boolean"
          },
          "practical_suitability": {
            "type": "boolean"
          },
          "benchmark_supported": {
            "type": "boolean"
          },
          "expected_decision": {
            "enum": [
              "QUANTUMIZE",
              "REMAIN_CLASSICAL"
            ]
          },
          "computational_intent": {
            "type": "object"
          },
          "classical_tests": {
            "minItems": 1
          },
          "semantic_oracle": {
            "type": "object"
          },
          "resource_expectations": {
            "type": "object"
          },
          "annotation_rationale": {
            "type": "string",
            "minLength": 1
          },
          "annotators": {
            "minItems": 2
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "case_type": {
                  "const": "positive"
                }
              }
            },
            "then": {
              "properties": {
                "structural_eligibility": {
                  "const": true
                },
                "practical_suitability": {
                  "const": true
                },
                "benchmark_supported": {
                  "const": true
                },
                "admissible_migration_contracts": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "case_type": {
                  "enum": [
                    "negative",
                    "hard_negative"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "negative_reason"
              ],
              "properties": {
                "negative_reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "anyOf": [
                {
                  "properties": {
                    "structural_eligibility": {
                      "const": false
                    }
                  }
                },
                {
                  "properties": {
                    "practical_suitability": {
                      "const": false
                    }
                  }
                },
                {
                  "properties": {
                    "benchmark_supported": {
                      "const": false
                    }
                  }
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "case_type": {
                  "const": "hard_negative"
                }
              }
            },
            "then": {
              "properties": {
                "candidate_regions": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "annotation_status": {
            "enum": [
              "ADJUDICATED",
              "FROZEN"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "required": [
              "adjudicator_id",
              "resolution"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "annotation_status": {
            "const": "FROZEN"
          }
        }
      },
      "then": {
        "required": [
          "benchmark_release"
        ]
      }
    }
  ]
}
